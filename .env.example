FLASK_ENV=production
SECRET_KEY=change-me-with-a-long-random-secret
# Production (single canonical database): shared MySQL on Mikrus Frog, credentials in /root/mysql.txt
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4
# Local development fallback: leave DATABASE_URL unset to use SQLite in instance/studentspot.db
APP_PORT=20412
SHOW_DEV_ACTIVATION_CODE=0
SESSION_COOKIE_SECURE=1
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_DEFAULT_SENDER=studentspot@example.edu
# Transactional mail przez HTTP API (z Froga port 587 jest zablokowany, 443 działa)
RESEND_API_KEY=
